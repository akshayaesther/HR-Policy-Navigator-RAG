# ==============================================================================
# Enterprise HR & Policy Navigator - Environment Configuration
# ==============================================================================

# Server Configuration
APP_NAME="Enterprise HR & Policy Navigator"
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Directory Paths (Relative to project root or absolute paths)
DOCUMENTS_DIR=backend/data/documents
VECTORSTORE_DIR=backend/data/vectorstore

# Document Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Database (ChromaDB)
CHROMA_COLLECTION_NAME=hr_policy_navigator

# Retrieval & Fusion Parameters
BM25_TOP_K=10
VECTOR_TOP_K=10
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RELEVANCE_SCORE_THRESHOLD=0.1

# Generation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.0
OLLAMA_REQUEST_TIMEOUT=60.0
